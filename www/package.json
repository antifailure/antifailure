{
  "name": "@antifailure/www",
  "version": "1.3.4",
  "private": true,
  "description": "Public Antifailure website: marketing pages, docs, and sign-in.",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/cms-snapshot.mjs && next dev",
    "images": "node scripts/optimize-images.mjs",
    "build": "node scripts/cms-snapshot.mjs && node scripts/optimize-images.mjs && next build && node scripts/markdown-twins.mjs",
    "start": "next start",
    "check:seo": "node scripts/check-seo.mjs",
    "test": "ls test/*.test.ts > /dev/null && node --import ./test/resolve.ts --test --test-concurrency=1 test/*.test.ts scripts/cms-snapshot.test.mjs",
    "typecheck": "node scripts/cms-snapshot.mjs && tsc --noEmit",
    "og": "node scripts/make-og.mjs"
  },
  "dependencies": {
    "@antifailure/website": "file:../web/packages/website",
    "geist": "^1.8.1",
    "motion": "^13.5.1",
    "next": "^16.4.3",
    "ogl": "^1.0.11",
    "posthog-js": "^1.438.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2"
  }
}
