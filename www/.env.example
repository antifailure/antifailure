# Auth.js. Generate one with: npx auth secret
AUTH_SECRET=
AUTH_URL=http://127.0.0.1:3000

# GitHub → Settings → Developer settings → OAuth Apps
# Callback: {AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web)
# Callback: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Azure Portal → App registrations
# Callback: {AUTH_URL}/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# PostHog, for product analytics and session replay on the marketing site.
#
# NEXT_PUBLIC_POSTHOG_KEY is a PostHog "project API key". It is public by
# design: it ships inside browser JavaScript, it can only write events into one
# project, and it reads nothing back. It is not a secret and it does not belong
# in a vault. A fork sets its own here; the empty string turns PostHog off for
# a build, including the request that would have fetched the library.
NEXT_PUBLIC_POSTHOG_KEY=phc_BXsb8vQVdiajf7uG9soRdsEwLtcE7tJWgdAfc4Vvoqau

# Where the browser sends events. A path means this site's own origin, which a
# reverse proxy forwards, so no request names a vendor. An absolute URL such as
# https://us.i.posthog.com bypasses the proxy and talks to PostHog directly,
# which is what a fork without a proxy of its own wants.
NEXT_PUBLIC_POSTHOG_API_HOST=/ingest

# Where a link built by the library should point. Never the proxy: the proxy
# serves the ingest API and knows nothing about the PostHog application.
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Where the session replay recorder script is fetched from. PostHog serves
# events and static assets from different hosts, so a proxy that forwards only
# the ingest paths still leaves the browser fetching a script from a
# posthog.com address. Empty means "derive it from the API host above", which
# is right when the proxy forwards /static/* as well.
NEXT_PUBLIC_POSTHOG_ASSET_HOST=
