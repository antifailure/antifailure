# The image is the control plane and nothing else. Everything below either
# belongs to another artifact or would put a secret, a credential, or a
# hundred megabytes of Go into a container that has no use for it.
.git
.github
engine
runner
tools
docs
examples
schemas
bin
infra
deploy
!deploy/docker/bootstrap.mjs
!deploy/docker/maintenance.mjs
ee
web/node_modules
web/**/node_modules
web/**/test
**/*.test.ts

# www is a different artifact. console/ is NOT: the control plane serves it, so
# its source has to reach the build context. Its own node_modules and previous
# output must not, because the image builds them from the lockfile.
www
console/node_modules
console/.next
console/out
**/.env
**/.env.*
*.md
