{
  "name": "@antifailure/api",
  "version": "1.3.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./boot": "./src/boot.ts",
    "./backup-cli": "./src/backup-cli.ts"
  },
  "bin": {
    "af-control-plane": "./src/main.ts",
    "af-control-plane-backup": "./src/backup-cli.ts",
    "af-operator": "./src/operator-cli.ts"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "ls test/*.test.ts > /dev/null && node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "openapi": "node scripts/openapi.ts ../../../www/public/openapi.json",
    "openapi:check": "node scripts/openapi.ts ../../../www/public/openapi.json --check"
  },
  "dependencies": {
    "@antifailure/db": "*",
    "@antifailure/policy": "*",
    "@antifailure/website": "*",
    "@hono/node-server": "^2.1.11",
    "@hono/trpc-server": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/api-logs": "0.223.0",
    "@opentelemetry/context-async-hooks": "2.12.1",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/sdk-logs": "0.223.2",
    "@opentelemetry/sdk-trace": "2.12.1",
    "@trpc/server": "^11.29.5",
    "agentrail-node": "0.4.1",
    "hono": "^4.13.19",
    "postgres": "^3.4.9",
    "posthog-node": "^5.74.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.0"
  }
}
