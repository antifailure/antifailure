{
  "name": "@antifailure/api",
  "version": "1.3.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/server.ts",
    "./boot": "./src/boot.ts",
    "./backup-cli": "./src/backup-cli.ts"
  },
  "bin": {
    "af-control-plane": "./src/main.ts",
    "af-control-plane-backup": "./src/backup-cli.ts",
    "af-operator": "./src/operator-cli.ts"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "ls test/*.test.ts > /dev/null && node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "openapi": "node scripts/openapi.ts ../../../www/public/openapi.json",
    "openapi:check": "node scripts/openapi.ts ../../../www/public/openapi.json --check"
  },
  "dependencies": {
    "@antifailure/db": "*",
    "@antifailure/policy": "*",
    "@hono/node-server": "^2.1.1",
    "@hono/trpc-server": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@trpc/server": "^11.18.0",
    "hono": "^4.13.7",
    "postgres": "^3.4.9",
    "posthog-node": "^5.52.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "^5.9.0"
  }
}
