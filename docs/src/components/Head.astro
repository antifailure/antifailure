---
/**
 * Starlight's head, plus the structured data that ties these pages to the
 * marketing site.
 *
 * Without this, the ~76 indexable documentation pages declare no relationship
 * to anything: an engine reading /docs/concepts/agents sees an article on a
 * domain, and has no way to learn that the domain's Organization, WebSite and
 * SoftwareApplication, all declared in www/lib/jsonld.tsx, are the same thing
 * it is reading about. The three `@id` values below are the anchors that file
 * publishes, so the graph closes across both builds rather than describing two
 * unrelated properties that happen to share a hostname.
 *
 * This replaces a static entry in the config's `head` array, which could only
 * say that a TechArticle exists here without saying which one: no @id, no url,
 * no headline, no date. It also went out on the 404, so that page claimed an
 * article and asked not to be indexed in the same head. Every field that makes
 * the claim worth anything is per page, and the config's head array is static.
 */
import Default from "@astrojs/starlight/components/Head.astro";
import { existsSync, readFileSync } from "node:fs";
import { resolve } from "node:path";

const { head, entry, lastUpdated } = Astro.locals.starlightRoute;
const snapshotPath = [resolve(process.cwd(), "../www/lib/cms-snapshot.generated.json"), resolve(process.cwd(), "www/lib/cms-snapshot.generated.json")].find(existsSync);
const snapshot = snapshotPath ? JSON.parse(readFileSync(snapshotPath, "utf8")) : { document: { fields: {} } };
const slug = Astro.url.pathname.split("/").filter(Boolean).join("-").replace(/[^a-zA-Z0-9_-]+/g, "-") || "docs";
const sourceTitle = String(head.find((tag) => tag.tag === "title")?.content ?? `${entry.data.title} | Antifailure`);

const attrOf = (tag: string, key: string, value: string) =>
  head.find((t) => t.tag === tag && t.attrs?.[key] === value)?.attrs;

// Read the canonical Starlight already computed rather than rebuilding it from
// Astro.url. `base` is /docs and `trailingSlash` is "never", so reconstructing
// it by hand is three chances to disagree with the tag on the same page.
const canonical = attrOf("link", "rel", "canonical")?.href;

// A page can set `robots: noindex` in its frontmatter, and the 404 does.
// Claiming an indexable article on a page that just asked not to be indexed is
// a contradiction an engine is entitled to resolve either way.
const robots = String(attrOf("meta", "name", "robots")?.content ?? "");
const indexable = !robots.includes("noindex");

const sourceDescription =
  entry.data.description ??
  String(attrOf("meta", "name", "description")?.content ?? "");
const titleValue = snapshot.document?.fields?.[`seo.${slug}.title`];
const descriptionValue = snapshot.document?.fields?.[`seo.${slug}.description`];
const titleEdited = typeof titleValue === "string" && Boolean(titleValue.trim());
const descriptionEdited = typeof descriptionValue === "string" && Boolean(descriptionValue.trim());
const title = titleEdited ? titleValue : sourceTitle;
const description = descriptionEdited ? descriptionValue : sourceDescription;
const articleHeadline = titleEdited ? title : entry.data.title;
for (const tag of head) {
  if (titleEdited && tag.tag === "title") tag.content = title;
  if (descriptionEdited && tag.tag === "meta" && (tag.attrs?.name === "description" || tag.attrs?.property === "og:description" || tag.attrs?.name === "twitter:description")) tag.attrs.content = description;
  if (titleEdited && tag.tag === "meta" && (tag.attrs?.property === "og:title" || tag.attrs?.name === "twitter:title")) tag.attrs.content = title;
}

const article =
  typeof canonical === "string" && indexable
    ? {
        "@context": "https://schema.org",
        "@type": "TechArticle",
        "@id": `${canonical}#techarticle`,
        url: canonical,
        mainEntityOfPage: canonical,
        headline: articleHeadline,
        ...(description ? { description } : {}),
        ...(lastUpdated ? { dateModified: lastUpdated.toISOString() } : {}),
        inLanguage: "en",
        isPartOf: { "@id": "https://antifailure.dev/#website" },
        publisher: { "@id": "https://antifailure.dev/#organization" },
        about: { "@id": "https://antifailure.dev/#software" },
      }
    : null;
---

<Default><slot /></Default>
<meta name="af-cms-source-title" content={sourceTitle} />
<meta name="af-cms-source-description" content={sourceDescription} />
<script src="/docs/cms-bridge.js" defer is:inline></script>
{
  article && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(article)}
      is:inline
    />
  )
}
