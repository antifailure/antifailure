---
const { pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
---

{
  (prev || next) && (
    <nav class="af-pager print:hidden" aria-label="Page">
      {prev ? (
        <a class="af-pager-link" href={prev.href} rel="prev">
          <span class="af-pager-dir">Previous</span>
          <span class="af-pager-title">{prev.label}</span>
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a class="af-pager-link af-pager-next" href={next.href} rel="next">
          <span class="af-pager-dir">Next</span>
          <span class="af-pager-title">{next.label}</span>
        </a>
      ) : null}
    </nav>
  )
}

<style>
  .af-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .af-pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: var(--af-radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }

  .af-pager-link:hover {
    border-color: var(--sl-color-hairline-light);
  }

  .af-pager-next {
    text-align: end;
    justify-self: end;
  }

  .af-pager-dir {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }

  .af-pager-title {
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--sl-color-white);
    overflow-wrap: anywhere;
  }

  @media (max-width: 40rem) {
    .af-pager {
      grid-template-columns: 1fr;
    }

    .af-pager-next {
      justify-self: stretch;
      text-align: start;
    }
  }
</style>
