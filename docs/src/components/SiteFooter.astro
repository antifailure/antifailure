---
/**
 * A short legal bar for documentation pages. The marketing sitemap does not
 * fit in Starlight's content column: it collides with the table of contents.
 */
---

<footer class="af-site-footer border-t border-gray-new-90 bg-white">
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-5">
    <p class="text-[13px] leading-normal tracking-extra-tight text-gray-new-50">
      © Antifailure 2026
    </p>
    <nav class="flex items-center gap-x-5 text-[13px] tracking-extra-tight text-gray-new-50" aria-label="Footer">
      <a class="py-1 transition-colors duration-200 hover:text-black" href="/privacy">Privacy</a>
      <a class="py-1 transition-colors duration-200 hover:text-black" href="/terms">Terms</a>
    </nav>
  </div>
</footer>
