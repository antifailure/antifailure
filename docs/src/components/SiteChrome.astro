---
/**
 * The site header, for the documentation.
 *
 * Same markup, same classes, same tokens as www/components/layout/SiteHeader.
 * The documentation used to wear Starlight's own bar, so moving between
 * antifailure.dev/pricing and antifailure.dev/docs changed the header, the
 * type and the palette, and read as two different products.
 *
 * That port had drifted from the thing it was copied from, and every one of
 * the differences was visible side by side at the same viewport width:
 *
 *   - the logo mark was 18px against the site's 24px, and the wordmark 15px
 *     against 16px, so the brand was physically a different size;
 *   - the header stood 64px tall from 1024px up while the site drops to 56px
 *     below 1280px, so at 1100px the two bars were different heights;
 *   - the site's nav collapses at `xl`, this one collapsed at `lg`;
 *   - "Writing" was missing from the navigation entirely;
 *   - the container fell to 20px of side padding below `sm`, the site's falls
 *     below `md`;
 *   - the leading gap was `gap-x-[92px] xl:gap-x-10`, which is the exact bug
 *     www fixed and left a comment about: the wide gap belongs at the wide end,
 *     and at 1024px this pushed the sign up button past the right edge.
 *
 * EVERY BREAKPOINT IN THIS FILE IS 50rem, AND THAT IS NOT A STYLE CHOICE.
 * Starlight's mobile menu is the only surface a collapsed link can live on and
 * it exists only below 50rem, so anything hidden at a WIDER breakpoint than
 * 50rem is hidden with nowhere to go. That is not a hypothetical. Measured on
 * a real build, at twenty widths:
 *
 *     width   nav  log in  sign up  github  menu button
 *     799      Y     n        n       n         Y
 *     800      Y     n        n       n         n     <- gap opens
 *     1023     Y     n        n       n         n
 *     1024     Y     Y        Y       Y         n     <- gap closes
 *
 * From 800px to 1023px the documentation offered no way to log in, no way to
 * sign up and no link to the repository, on any of 82 pages, because the
 * buttons were hidden at `lg` while the menu that holds their only copies
 * stops at 50rem. The docs footer carries Privacy and Terms and nothing else,
 * so there was no other route. iPad portrait is 810 to 834.
 *
 * Three different boundaries caused it: the nav at `md`, the buttons at `lg`,
 * the menu at 50rem. The comment here used to claim the nav collapsed "at
 * Starlight's own 50rem reflow point" while the class said `max-md`, which is
 * how the seam stayed invisible. So: one boundary, written as 50rem, matching
 * the menu exactly, with no Tailwind breakpoint name in sight, because `md`
 * and `lg` are the two values that are wrong here.
 *
 * GitHub is the exception and stays at `lg`. At 800px the row measures 890px
 * with it and 749px without, so keeping it would push the sign up button off
 * the edge, which is the bug this file already fixed once. It is in the mobile
 * menu below 50rem and in the footer of every marketing page.
 *
 * The dropdown panels from the marketing header are deliberately not here.
 * They are hover-driven React state, and the documentation already has a
 * sidebar doing navigation; a second overlapping navigation system would be
 * the inconsistency this is meant to remove. The top-level destinations are
 * links.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// `/docs`, not `/docs/`. www/lib/nav.ts writes the slashless form and the host
// redirects the other one, so the trailing slash made the site's own Docs link
// the only navigation on antifailure.dev that costs a round trip.
const docsHome = base || "/docs";

// Docs is the current SECTION on all 82 pages and the current PAGE on exactly
// one of them. `aria-current="page"` was hardcoded true, so a screen reader
// reading /docs/reference/cli was told it was already on the Docs page.
// "true" is the value for "this is the relevant one" when it is not the page.
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
  { text: "Product", href: "/product" },
  { text: "Solutions", href: "/solutions" },
  // Two fixes on one line. `base`, not `${base}/`: the host sets
  // "trailingSlash": "never", so the slashed form 301s, and this is the Docs
  // link in the header of all 82 documentation pages, which made it the
  // most-served redirect on the site. And `current` is computed rather than
  // hardcoded true, so the one page that IS the Docs home says "page" and the
  // other 81, for which Docs is the section and not the page, say "true".
  { text: "Docs", href: docsHome, current: here === docsHome ? "page" : "true" },
  { text: "Writing", href: "/blog" },
  { text: "Pricing", href: "/pricing" },
];
---

<header
  class="af-header relative z-50 flex h-16 w-full items-center bg-white after:absolute after:right-0 after:bottom-0 after:left-0 after:h-px after:bg-gray-new-90 max-xl:h-14"
>
  <div
    class="relative mx-auto flex w-full max-w-[1856px] items-center justify-between gap-x-6 px-8 max-lg:max-w-none max-lg:px-8 max-md:px-5"
  >
    <div class="flex items-center gap-x-6 xl:gap-x-10">
      <a
        href="/"
        class="af-wordmark flex h-8 shrink-0 items-center gap-2.5"
        aria-label="Antifailure"
      >
        <svg viewBox="0 0 18 18" class="h-6 w-6 shrink-0" fill="none" aria-hidden="true">
          <path
            d="M1.8 6.4V1.8H6.4M11.6 1.8H16.2V6.4M16.2 11.6V16.2H11.6M6.4 16.2H1.8V11.6"
            stroke="#33bf00"
            stroke-width="2.1"
            stroke-linecap="square"></path>
        </svg>
        <span class="text-[16px] leading-none font-medium tracking-extra-tight text-black">
          Antifailure
        </span>
      </a>

      <nav class="max-[50rem]:hidden" aria-label="Main">
        <ul class="flex items-center">
          {
            nav.map((item, i) => (
              <li class="flex h-16 items-center max-xl:h-14">
                <a
                  href={item.href}
                  aria-current={item.current}
                  class:list={[
                    "relative flex h-16 items-center gap-x-1 rounded-sm px-2.5 text-[15px] leading-normal font-normal tracking-snug whitespace-pre transition-colors duration-200 hover:text-black max-xl:h-14",
                    item.current ? "text-black" : "text-black/70",
                    i === 0 && "-ml-2.5",
                  ]}
                >
                  {item.text}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="flex items-center gap-x-8 max-[50rem]:hidden">
      <div class="flex items-center gap-x-6 max-lg:hidden">
        <a
          href="https://github.com/antifailure/antifailure"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-1.5 rounded-sm py-1.5 text-black transition-colors duration-200 hover:text-gray-new-40"
        >
          <svg
            viewBox="0 0 24 24"
            class="h-[18px] w-[18px] text-gray-new-20"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.26.8-.58v-2.02c-3.34.72-4.04-1.61-4.04-1.61c-.55-1.39-1.34-1.76-1.34-1.76c-1.09-.75.08-.73.08-.73c1.2.08 1.84 1.24 1.84 1.24c1.07 1.83 2.81 1.3 3.5 1c.1-.78.42-1.3.76-1.6c-2.67-.3-5.47-1.33-5.47-5.93c0-1.31.47-2.38 1.24-3.22c-.13-.3-.54-1.52.12-3.18c0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23c.66 1.66.25 2.88.12 3.18c.77.84 1.24 1.91 1.24 3.22c0 4.61-2.81 5.63-5.48 5.92c.43.37.81 1.1.81 2.22v3.29c0 .32.22.69.82.58A12 12 0 0 0 12 .3z"
            ></path>
          </svg>
          <span class="text-sm leading-none tracking-extra-tight">GitHub</span>
        </a>
      </div>
      <div class="flex gap-x-3.5">
        <a
          href="/signin"
          class="inline-flex h-9 cursor-pointer items-center justify-center rounded-full border border-black/40 bg-black/[0.02] px-[18px] text-sm font-medium tracking-extra-tight text-black transition-colors duration-200 hover:border-black"
          >Log in</a
        >
        <a
          href="/signup"
          class="inline-flex h-9 cursor-pointer items-center justify-center rounded-full bg-black px-[18px] text-sm font-medium tracking-extra-tight text-white transition-colors duration-200 hover:bg-[#292929]"
          >Sign up</a
        >
      </div>
    </div>
  </div>
</header>

<style>
  /* The focus ring has to be there the instant focus lands, and it was not.
   *
   * Tailwind v4 added `outline-color` to what `transition-colors` animates, and
   * every link in this bar carries `transition-colors duration-200`. So the
   * ring interpolates from the element's own colour to the brand green over
   * 200ms. Measured on Sign up, holding focus and sampling:
   *
   *     t~0ms    rgb(255,255,255)   invisible, white on the white header
   *     t~50ms   rgb(185,233,167)
   *     t~150ms  rgb(52,191,1)
   *     t~300ms  rgb(51,191,0)      settled
   *
   * Log in starts at black on white so it looks instant and hid the defect for
   * both of them. Tabbing quickly along the bar never shows a finished ring on
   * either. Only the colour is excluded here: hover still animates, because
   * that transition is the reason the class is on these links at all.
   *
   * The same two lines belong in www/components/layout/SiteHeader.tsx, which
   * has the identical markup and therefore the identical defect. */
  .af-header a:focus-visible,
  .af-header button:focus-visible {
    transition-property: color, background-color, border-color;
  }
</style>
