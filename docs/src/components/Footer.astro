---
/**
 * Starlight's per-page footer (edit link, last updated, previous/next), then
 * the site footer beneath it, so every page on antifailure.dev ends the same
 * way.
 */
import Default from "@astrojs/starlight/components/Footer.astro";
import SiteFooter from "./SiteFooter.astro";
---

<Default><slot /></Default>
<SiteFooter />

<style>
  :global(.af-site-footer) {
    margin-top: 2rem;
  }

  :global(footer.sl-flex .meta) {
    margin-top: 2rem;
  }
</style>
