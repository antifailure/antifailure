---
// The docs 404.
//
// Most people who land here arrived from an error message in a terminal, not
// from a link on this site. The engine prints https://antifailure.dev/docs/<path>
// at the end of every failure, and a mistyped or renamed path lands here. So
// this page's job is not to apologise: it is to get somebody who is already
// having a bad afternoon to the page they were promised, and to tell them the
// one thing they cannot work out on their own, which is that the URL in their
// terminal is the one that is wrong.
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const routes = [
  { href: `${base}/getting-started/quickstart`, label: "Quickstart", note: "Install it and get a first environment up." },
  { href: `${base}/reference/errors`, label: "Error reference", note: "Every code the engine can return, with its cause." },
  { href: `${base}/reference/cli`, label: "Command reference", note: "Every command and flag, generated from the binary." },
  { href: `${base}/reference/manifest`, label: "Manifest reference", note: "Every key in antifailure.yaml." },
];
---

<StarlightPage
  frontmatter={{
    title: "That page is not here",
    template: "splash",
    tableOfContents: false,
    pagefind: false,
    head: [{ tag: "meta", attrs: { name: "robots", content: "noindex" } }],
  }}
>
  <p class="af-404-lead">
    Nothing is published at this address. If you followed a link out of an
    Antifailure error message, that is a bug in the product rather than a
    mistake you made, and it is worth
    <a href="https://github.com/antifailure/antifailure/issues/new">reporting</a>:
    every error code is supposed to name a page that exists, and a build gate
    checks it.
  </p>

  <ul class="af-404-routes not-content">
    {
      routes.map((r) => (
        <li>
          <a href={r.href}>{r.label}</a>
          <span>{r.note}</span>
        </li>
      ))
    }
  </ul>

  <p class="af-404-search">
    The search box at the top of the page reads every word on this site, and is
    usually faster than guessing at a path.
  </p>
</StarlightPage>

<style>
  .af-404-lead {
    max-width: 46ch;
    font-size: var(--sl-text-lg);
    line-height: 1.65;
    color: var(--sl-color-gray-2);
  }

  .af-404-routes {
    margin-top: 2.5rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0;
    max-width: 34rem;
    border-top: 1px solid var(--af-rule);
  }

  .af-404-routes li {
    display: grid;
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    gap: 0 1.5rem;
    align-items: baseline;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--af-rule);
  }

  .af-404-routes a {
    font-weight: 600;
    color: var(--af-accent-ink);
    text-decoration: none;
  }

  .af-404-routes a:hover {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .af-404-routes span {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }

  .af-404-search {
    margin-top: 2rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    max-width: 46ch;
  }

  /* One column below the point where two would squeeze the note to three words
     per line. Checked at 320, 360 and 390. */
  @media (max-width: 34rem) {
    .af-404-routes li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }
</style>
